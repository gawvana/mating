# ==========================================
# Mating Production & Local Configuration
# ==========================================

APP_ENV=production
DEBUG=false

# Database Configuration (Supabase Transaction Pooler / PostgreSQL async)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Telegram Bot & Webhook
BOT_TOKEN=
WEBHOOK_SECRET=
WEBAPP_URL=

# AI Parsing
AI_PROVIDER=gemini
AI_PRIMARY_KEY=
AI_API_KEY=
AI_FALLBACK_KEY=
AI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_PER_MINUTE=30

# CORS & Security
ALLOWED_ORIGINS=https://mating.vercel.app,https://web.telegram.org,https://*.telegram.org
