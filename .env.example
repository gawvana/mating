# ==========================================
# Mating Environment Configuration
# ==========================================

# App Environment: development, test, production
APP_ENV=development
DEBUG=false

# Telegram Bot Credentials
BOT_TOKEN=123456789:AAExampleBotTokenPlaceholder
WEBHOOK_SECRET=your-random-webhook-secret-token
WEBAPP_URL=https://your-domain.com

# Database URL
# Development: SQLite async (default)
DATABASE_URL=sqlite+aiosqlite:///./mating.db
# Production: PostgreSQL async
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mating

# Redis Cache & Rate Limiting (optional)
# REDIS_URL=redis://localhost:6379/0

# AI Parsing Configuration
AI_PROVIDER=gemini
AI_PRIMARY_KEY=your-gemini-or-groq-api-key-here
AI_FALLBACK_KEY=your-fallback-api-key-here
AI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_PER_MINUTE=30

# CORS Allowed Origins (Comma separated or JSON array)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://web.telegram.org
